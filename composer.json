{
    "name": "infrangible/m2-catalog-login-required",
    "description": "Restricts selected categories and products to logged-in customers: guests are sent to the login page and such products are hidden from their product lists and search results.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Customers",
        "Catalog",
        "login required for categories and products",
        "hide products from guests",
        "B2B catalog for logged-in customers"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-login-required",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.7",
        "infrangible/m2-foundation": "~3.0.2",
        "magento/framework": "~103.0.6",
        "magento/module-advanced-search": "~100.4.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-catalog-search": "~102.0.0",
        "magento/module-customer": "~103.0.0",
        "magento/module-eav": "~102.1.0",
        "magento/module-store": "~101.1.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogLoginRequired\\": "src"
        }
    }
}
